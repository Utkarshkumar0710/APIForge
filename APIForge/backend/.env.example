# Server
PORT=4000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=12345
DB_NAME=apiforge

# JWT
JWT_SECRET=your_jwt_secret_here

# OpenWeather (store your real key here)
OPENWEATHER_API_KEY=YOUR_REAL_OPENWEATHER_KEY

# SMTP (for nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="APIForge <no-reply@apiforge.example>"
